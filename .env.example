# 阿里云百炼智能体应用
BAILIAN_APP_ID=your_app_id
BAILIAN_API_KEY=sk-xxxxxxxx
BAILIAN_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/apps/{app_id}/completion
BAILIAN_TIMEOUT=60            # 单次请求超时（秒）
BAILIAN_MAX_RETRIES=3         # 失败重试次数
BAILIAN_RETRY_BACKOFF=2       # 重试退避基数（秒），指数退避：2,4,8...

# 分块与扫描
CHUNK_MAX_CHARS=2000          # 块最大字符数
INPUT_DIR=./input             # 默认输入目录
TEXT_EXTENSIONS=.txt,.md      # 处理的扩展名（小写，逗号分隔）
